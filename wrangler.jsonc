// Cloudflare Pages configuration: https://developers.cloudflare.com/pages/functions/wrangler-configuration/
// Build with `pnpm build`. Set the `TURNSTILE_SECRET_KEY` secret on the project, in both the
// production and preview environments, for the contact form (`functions/api/contact.js`).
{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "www-webdino-org",
  "pages_build_output_dir": "./dist",
  "compatibility_date": "2026-10-27",
}
