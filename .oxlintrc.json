{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "plugins": ["typescript", "unicorn", "oxc", "import", "jsdoc"],
  "categories": {
    "correctness": "error",
    "suspicious": "warn"
  },
  "rules": {
    "import/no-unassigned-import": [
      "warn",
      {
        "allow": ["**/*.css", "@styles/*"]
      }
    ]
  },
  "env": {
    "builtin": true,
    "browser": true,
    "node": true,
    "astro": true
  },
  "ignorePatterns": ["dist/**", ".astro/**"]
}
