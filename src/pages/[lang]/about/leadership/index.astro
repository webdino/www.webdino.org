---
import BoardMember from '@components/BoardMember.astro';
import BoardMembers from '@components/BoardMembers.astro';
import FeatureHeader from '@components/FeatureHeader.astro';
import Heading from '@components/Heading.astro';
import { getLocale, getLocaleParams } from '@i18n/utils';
import AboutLayout from '@layouts/AboutLayout.astro';
import { getPage } from '@lib/content';
import { markdownify } from '@lib/markdown';
import { getPageProps } from '@lib/navigation';

export const getStaticPaths = () => getLocaleParams().map((params) => ({ params }));

const locale = getLocale(Astro.currentLocale);
const { data } = await getPage(locale, 'leadership');
const { message, leadership } = data;
const [chairperson, ...roles] = leadership.roles;
const representative = chairperson?.members[0];
// Directors, then two roles side by side, then all the others
const roleRows = [roles.slice(0, 1), roles.slice(1, 3), roles.slice(3)].filter((row) => row.length);
---

<AboutLayout {...await getPageProps(locale, 'leadership')}>
  <main>
    <FeatureHeader title={data.title} subtitle={data.subtitle} description={data.description} />
    <div id="main-content">
      <section id="message" class="outer">
        <header class="large">
          <div class="inner row">
            <div class="col">
              <h2>
                <Heading text={message.heading} />
              </h2>
            </div>
          </div>
        </header>
        <div class="inner row">
          <div class="col s2">{representative && <BoardMember {...representative} />}</div>
          <div class="col s6">
            <div class="body" set:html={markdownify(message.text)} />
          </div>
        </div>
      </section>
      <section id="leadership" class="outer">
        <header class="large">
          <div class="inner row">
            <div class="col">
              <h2>
                <Heading text={leadership.heading} />
              </h2>
            </div>
          </div>
        </header>
        <div class="inner">
          {roleRows.map((row) => (
            <div class="row">
              <div class="col">
                {row.map((role) => (
                  <BoardMembers {...role} />
                ))}
              </div>
            </div>
          ))}
        </div>
      </section>
    </div>
  </main>
</AboutLayout>
