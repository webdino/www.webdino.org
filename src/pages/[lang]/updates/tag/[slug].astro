---
import type { CollectionEntry } from 'astro:content';
import type { Locale } from '@i18n/ui';
import { useTranslations } from '@i18n/utils';
import ArchiveLayout from '@layouts/ArchiveLayout.astro';
import { getTermRoutes, type Post } from '@lib/content';
import { getTagPath } from '@lib/navigation';

export const getStaticPaths = () => getTermRoutes('tags');

interface Props {
  locale: Locale;
  term: CollectionEntry<'tags'>['data'];
  posts: Post[];
}

const { locale, term, posts } = Astro.props;
const title = useTranslations(locale)('updates.tag.title', { name: term.name });
---

<ArchiveLayout
  locale={locale}
  title={title}
  href={getTagPath(locale, term.title)}
  posts={posts}
  section="updates"
  page="tags"
>
  <header>
    <hgroup>
      <h2>{title}</h2>
    </hgroup>
    <span class="fas circle" aria-hidden="true"></span>
  </header>
</ArchiveLayout>
