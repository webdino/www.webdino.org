---
import FeatureHeader from '@components/FeatureHeader.astro';
import SectionHeader from '@components/SectionHeader.astro';
import { getLocale, getLocaleParams, useTranslations } from '@i18n/utils';
import BaseLayout from '@layouts/BaseLayout.astro';
import '@styles/contact.css';
import { getPage } from '@lib/content';
import { markdownify } from '@lib/markdown';
import { getPageProps } from '@lib/navigation';

export const getStaticPaths = () => getLocaleParams().map((params) => ({ params }));

/**
 * Pages Function that verifies the Cloudflare Turnstile token and passes the submission on to
 * Netlify Forms (`functions/api/contact.js`).
 */
const FORM_ENDPOINT = '/api/contact';

/**
 * Cloudflare Turnstile site key, set as a build environment variable on the Cloudflare Pages
 * project. Without the variable, e.g. in local development, use the test key that always passes.
 * @see https://developers.cloudflare.com/turnstile/troubleshooting/testing/
 */
const TURNSTILE_SITE_KEY = process.env.TURNSTILE_SITE_KEY || '1x00000000000000000000AA';

const locale = getLocale(Astro.currentLocale);
const t = useTranslations(locale);
const { data } = await getPage(locale, 'contact');
const { fields, submit, thanks, error } = data;
const messages = [
  { id: 'thanks', ...thanks },
  { id: 'error', ...error },
];
---

<BaseLayout {...await getPageProps(locale, 'contact')} contact={false}>
  <main>
    <FeatureHeader title={data.title} subtitle={data.subtitle} description={data.description} />
    <div id="main-content">
      <form name="contact" method="POST" action={FORM_ENDPOINT} data-astro-reload>
        <div class="outer main">
          <div class="inner row">
            <div class="col">
              {fields.map((field) => (
                <p class="field">
                  <label for={`input-${field.name}`}>{field.label}</label>
                  <span class="req">{field.required && t('contact.required')}</span>
                  <span class="input">
                    {field.type === 'multiline' ? (
                      <textarea
                        id={`input-${field.name}`}
                        name={field.name}
                        required={field.required}
                        placeholder={field.placeholder}
                      ></textarea>
                    ) : (
                      <input
                        id={`input-${field.name}`}
                        type={field.type}
                        name={field.name}
                        required={field.required}
                        placeholder={field.placeholder}
                      />
                    )}
                  </span>
                </p>
              ))}
              <p hidden>
                <label>
                  {t('contact.honeypot')} <input name="bot-field" />
                </label>
              </p>
            </div>
          </div>
        </div>
        <div class="outer submit">
          <div class="inner row">
            <div class="col">
              <div
                class="cf-turnstile"
                data-sitekey={TURNSTILE_SITE_KEY}
                data-language={locale}
                data-theme="light"
              ></div>
              <p>
                <label>
                  <input type="checkbox" name="privacy" required />{' '}
                  <Fragment set:html={markdownify(submit.privacy)} />
                </label>
              </p>
              <p class="field">
                <button type="submit">
                  <span class="far paper-plane" aria-hidden="true"></span>
                  <strong>{submit.buttonLabel}</strong>
                </button>
              </p>
            </div>
          </div>
        </div>
        {messages.map((message) => (
          <div class={`outer ${message.id}`} hidden tabindex="-1">
            <div class="inner row">
              <div class="col">
                <SectionHeader heading={message.heading} subheading={message.subheading} />
                <p set:html={markdownify(message.description)} />
              </div>
            </div>
          </div>
        ))}
      </form>
    </div>
  </main>
</BaseLayout>

<script>
  /** @type {Promise<void> | undefined} */
  let turnstileLoader;

  /**
   * Load the Cloudflare Turnstile script once. It’s added on demand rather than with a `<script>`
   * element, because the view transition router doesn’t run it again after navigating to the
   * contact page.
   * @see https://developers.cloudflare.com/turnstile/get-started/client-side-rendering/
   * @returns {Promise<void>} Promise resolved once `window.turnstile` is available.
   */
  const loadTurnstile = () => {
    turnstileLoader ??= new Promise((resolve, reject) => {
      const $script = document.createElement('script');

      $script.src = 'https://challenges.cloudflare.com/turnstile/v0/api.js?render=explicit';
      $script.addEventListener('load', () =>
        window.turnstile ? resolve(undefined) : reject(new Error('Turnstile not loaded')),
      );
      $script.addEventListener('error', reject);
      document.head.append($script);
    }).catch((error) => {
      // Try again on the next visit
      turnstileLoader = undefined;
      throw error;
    });

    return turnstileLoader;
  };

  /**
   * Render the Turnstile widget and submit the form with Ajax to the Pages Function given in the
   * form’s `action`, which verifies the Turnstile token and passes the submission on to Netlify
   * Forms.
   */
  document.addEventListener('astro:page-load', () => {
    const $form = document.querySelector('form[name="contact"]');

    // This script stays loaded after navigating away from the contact page
    if (!($form instanceof HTMLFormElement)) {
      return;
    }

    const $main = $form.querySelector('.main');
    const $submit = $form.querySelector('.submit');
    const $thanks = $form.querySelector('.thanks');
    const $error = $form.querySelector('.error');
    const $button = $submit?.querySelector('button');
    const $turnstile = $form.querySelector('.cf-turnstile');

    if (
      !(
        $button &&
        $main instanceof HTMLElement &&
        $submit instanceof HTMLElement &&
        $thanks instanceof HTMLElement &&
        $error instanceof HTMLElement &&
        $turnstile instanceof HTMLElement
      )
    ) {
      return;
    }

    loadTurnstile()
      .then(() => {
        // The visitor left the page while the script was loading
        if (!$turnstile.isConnected) {
          return;
        }

        const widgetId = window.turnstile?.render($turnstile);

        if (!widgetId) {
          throw new Error('Turnstile not rendered');
        }

        // Clean up the widget when the view transition router swaps the page out
        document.addEventListener('astro:before-swap', () => window.turnstile?.remove(widgetId), {
          once: true,
        });
      })
      .catch(() => {
        $main.hidden = true;
        $submit.hidden = true;
        $error.hidden = false;
        $error.focus();
      });

    $form.querySelector('a[href$="/privacy/"]')?.setAttribute('target', '_blank');

    $form.addEventListener('submit', async (event) => {
      event.preventDefault();

      const formData = new FormData($form);

      // The challenge isn’t solved yet; the widget shows its status
      if (!formData.get('cf-turnstile-response')) {
        $turnstile.scrollIntoView({ block: 'center', behavior: 'smooth' });

        return;
      }

      const fields = [...formData].map(([name, value]) => [name, String(value)]);

      $button.disabled = true;
      $error.hidden = true;

      try {
        // Not `$form.action`, which a field named `action` would shadow
        const response = await fetch($form.getAttribute('action') ?? '', {
          method: 'POST',
          headers: { 'Content-Type': 'application/x-www-form-urlencoded' },
          body: new URLSearchParams(fields).toString(),
        });

        if (!response.ok) {
          throw new Error(`Submission failed: ${response.status}`);
        }

        $main.hidden = true;
        $submit.hidden = true;
        $thanks.hidden = false;
        $thanks.focus();
      } catch {
        // Keep the form with what the visitor typed so they can try again. The token can only be
        // verified once, so get a new one.
        window.turnstile?.reset($turnstile);
        $button.disabled = false;
        $error.hidden = false;
        $error.focus();
      }
    });
  });
</script>
